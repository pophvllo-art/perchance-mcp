# ── REQUIRED ────────────────────────────────────────────────────────────────
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
PERCHANCE_API_KEY=

# ── optional ────────────────────────────────────────────────────────────────
# Public base URL of this deployment, used to build image links AND to tell
# the MCP SDK which Host header to accept.
PUBLIC_URL=

# Allow the key as ?api_key=... (needed by MCP clients that cannot send
# custom headers). Set to 0 to force header-only auth.
PERCHANCE_ALLOW_QUERY_KEY=1

# Extra hosts to allow, comma separated (only needed if PUBLIC_URL is wrong).
# PERCHANCE_ALLOWED_HOSTS=my-service.cloady.io

# Set to 1 to turn off the MCP SDK's DNS-rebinding Host check entirely.
# PERCHANCE_DISABLE_DNS_REBINDING_PROTECTION=1

HOST=0.0.0.0
PORT=8080

# Browser
PERCHANCE_BROWSER_DIR=/data/browser
PERCHANCE_DISPLAY=:99
PERCHANCE_USE_XVFB=1
PERCHANCE_READY_TIMEOUT=180
# How long the embed page gets to solve Turnstile and mint a userKey.
PERCHANCE_IDENTITY_TIMEOUT=120

# Generation defaults
PERCHANCE_DEFAULT_RESOLUTION=768x768
PERCHANCE_DEFAULT_GUIDANCE=7
PERCHANCE_MAX_IMAGES=4
PERCHANCE_GEN_TIMEOUT=180

# Where generated images are written
PERCHANCE_IMAGE_DIR=/data/images
PERCHANCE_IMAGE_TTL=3600

# Save to your perchance gallery to get permanent CDN links (leave blank to skip)
PERCHANCE_GALLERY_NAME=
PERCHANCE_SAVE_CHANNEL=

PERCHANCE_DEBUG=0
